# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Supabase Auth public client config ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ─── App Secrets ──────────────────────────────────────────────────────────────
APP_AUTH_SECRET="replace-with-strong-secret"
APP_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# ─── App Config ───────────────────────────────────────────────────────────────
APP_PUBLIC_BASE_URL="Your_app_public_base_url"
RATE_LIMIT_PER_MINUTE="60"
PASSWORD_RESET_TTL_MINUTES="60"
PROVIDER_REQUEST_TIMEOUT_MS="30000"

# ─── KeyLM free tier Model ────────────────────────────────────────────────────
GROQ_API_KEY="your-groq-api-key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_FREE_MODEL="moonshotai/kimi-k2-instruct-0905"
GROQ_FREE_FALLBACK_MODELS="llama-3.1-8b-instant"
FREE_USER_DAILY_LIMIT="50"
FREE_GLOBAL_DAILY_LIMIT="1000"
