# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@host:5432/postgres"

# ─── Supabase Auth public client config ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-cloudflare-turnstile-site-key"
# Supabase Auth redirect URL must include:
# Local: http://localhost:3000/auth/callback
#Production: https://your-domain.com/auth/callback
# In Supabase Dashboard > Authentication > Email, set OTP expiry to 900 seconds (15 minutes).
# Configure TURNSTILE_SECRET_KEY only in Supabase Dashboard Captcha settings, not in frontend env.

# ─── App Secrets ──────────────────────────────────────────────────────────────
APP_AUTH_SECRET="replace-with-strong-secret"
APP_ENCRYPTION_KEY="base64-encoded-32-byte-key"
METRICS_TOKEN="your-metrics-token-if-applicable"

# ─── App Config ───────────────────────────────────────────────────────────────
APP_PUBLIC_BASE_URL="set_to_your_app_url"
RATE_LIMIT_PER_MINUTE="60"
PASSWORD_RESET_TTL_MINUTES="60"
PROVIDER_REQUEST_TIMEOUT_MS="30000"

# ─── KeyLM shared Free/Pro catalog ────────────────────────────────────────────
GROQ_API_KEY="your-groq-api-key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_FREE_MODEL="moonshotai/kimi-k2-instruct-0905"
GROQ_FREE_FALLBACK_MODELS="llama-3.1-8b-instant"
MIMO_API_KEY="your-xiaomi-mimo-api-key"
MIMO_BASE_URL="https://api.xiaomimimo.com/v1"
FREE_USER_DAILY_LIMIT="50"
FREE_GLOBAL_DAILY_LIMIT="1000"
