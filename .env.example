# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Pooled connection (port 6543) — used at runtime by Prisma Client
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by Prisma Migrate only
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── For local development (uncomment and use instead of Supabase URLs) ────────
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/keylm"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/keylm"

# ─── App Secrets ──────────────────────────────────────────────────────────────
# JWT signing secret — generate with: openssl rand -hex 32
APP_AUTH_SECRET="replace-with-strong-secret"
# AES-256-GCM encryption key for API keys — generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# ─── App Config ───────────────────────────────────────────────────────────────
APP_PUBLIC_BASE_URL="https://keylm.shakilahmed.tech"
RATE_LIMIT_PER_MINUTE="60"
PASSWORD_RESET_TTL_MINUTES="60"
PROVIDER_REQUEST_TIMEOUT_MS="30000"

# ─── KeyLM free tier Model ───────────────────────────────────────────────
GROQ_API_KEY="your-groq-api-key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_FREE_MODEL="moonshotai/kimi-k2-instruct-0905"
GROQ_FREE_FALLBACK_MODELS="llama-3.1-8b-instant"
FREE_USER_DAILY_LIMIT="50"
FREE_GLOBAL_DAILY_LIMIT="1000"
