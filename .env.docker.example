# Docker Compose local environment for KeyLM
# Copy this file to `.env` before running `docker compose up --build`

# App ports
APP_PORT=3000
POSTGRES_PORT=5432

# Local PostgreSQL settings used by docker-compose
POSTGRES_DB=keylm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Required app secrets
# Generate with: openssl rand -hex 32
APP_AUTH_SECRET=replace-with-a-strong-secret
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# App config
APP_PUBLIC_BASE_URL=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
PASSWORD_RESET_TTL_MINUTES=60
PROVIDER_REQUEST_TIMEOUT_MS=30000

# Optional Groq-backed free tier
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FREE_MODEL=moonshotai/kimi-k2-instruct-0905
GROQ_FREE_FALLBACK_MODELS=llama-3.1-8b-instant
FREE_USER_DAILY_LIMIT=50
FREE_GLOBAL_DAILY_LIMIT=1000

# DATABASE_URL and DIRECT_URL are injected by docker-compose for the local db service.
