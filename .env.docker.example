# Optional Docker Compose local overrides for KeyLM.
# You can run `docker compose up --build` without this file because
# docker-compose.yml includes safe local-development defaults.
# Copy to `.env` only when you want real Supabase/Groq values or custom ports.

# App ports
APP_PORT=3000
POSTGRES_PORT=5432

# Local PostgreSQL settings used by docker-compose
POSTGRES_DB=keylm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Supabase Auth public client config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase Auth redirect URL must include:
# Local: http://localhost:3000/auth/callback
# Production: https://your-domain.com/auth/callback
# In Supabase Dashboard > Authentication > Email, set OTP expiry to 900 seconds.
# Configure TURNSTILE_SECRET_KEY only in Supabase Dashboard Captcha settings.

# Required app secrets. These defaults are for local development only.
# For real usage generate new values:
# APP_AUTH_SECRET: openssl rand -hex 48
# APP_ENCRYPTION_KEY: openssl rand -base64 32
APP_AUTH_SECRET=dev-only-insecure-auth-secret-change-me
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# App config
APP_PUBLIC_BASE_URL=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
PASSWORD_RESET_TTL_MINUTES=60
PROVIDER_REQUEST_TIMEOUT_MS=30000

# Optional Groq-backed free tier
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FREE_MODEL=moonshotai/kimi-k2-instruct-0905
GROQ_FREE_FALLBACK_MODELS=llama-3.1-8b-instant
FREE_USER_DAILY_LIMIT=50
FREE_GLOBAL_DAILY_LIMIT=1000

# DATABASE_URL and DIRECT_URL are injected by docker-compose for the local db service.
